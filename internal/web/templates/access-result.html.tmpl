{{- /*
  Access-request decision result. Renders web.AccessDecisionResultView:
  the fire-and-observe outcome of one approve or deny. The console wrote
  the request status; the operator's controller acts on an approval. The
  list reflects the write once the informer catches up.
*/ -}}
{{template "page-head" "access decision"}}
{{template "shell-open" .Shell}}
  <header>
    <div class="header-bar">
      <h1>pgConsole — decision recorded</h1>
    <dl class="target"><dt>Cluster</dt><dd>{{.ClusterName}}</dd></dl>
    </div>
  </header>
    <section class="panel">
      <h2>{{.Action}} — {{.Request}}</h2>
      {{- if .Accepted}}
      <p class="state">recorded: the decision was written to the request status. The operator's controller acts on an approval; this console does not create users.</p>
      {{- else}}
      <p class="state">not recorded: {{.Outcome}}. Nothing was changed by this console beyond the attempt.</p>
      {{- end}}
    </section>
{{template "shell-close"}}
