{{- /*
  Diagnostics. Renders web.DiagnosticsView: findings correlated from the
  snapshots the other screens already render, and — equally load-bearing
  — the account of what was checked.

  The second panel is not decoration. Findings alone would make an empty
  screen read as "nothing is wrong", which is a claim derived from the
  absence of a match rather than from anything a source reported. The
  checks are therefore all on the page, grouped by outcome: matches and
  checks that could not run stay expanded, while the clear majority
  collapses under one counted line. The details element is ordinary
  markup — a reader without script opens it the same way.
*/ -}}
{{template "page-head" "diagnostics"}}
{{template "shell-open" .Shell}}
  <header>
    <div class="header-bar">
      <h1>Diagnostics</h1>
    <dl class="target">
      <dt>Cluster</dt><dd>{{.ClusterName}}</dd>
    </dl>
    </div>
    <p class="lede">Every finding restates what a source reported and quotes it. None concludes anything a source did not say.</p>
  </header>

  <section class="panel">
    <h2>Findings</h2>
    {{- if .Findings}}
    {{- range .Findings}}
    <article class="finding" data-severity="{{.Severity}}">
      <div class="finding-head">
        <span class="sev">{{.Severity}}</span>
        <h3>{{.Summary}}</h3>
      </div>
      {{- if .Detail}}
      <p class="finding-detail">{{.Detail}}</p>
      {{- end}}
      {{- range .Evidence}}
      <div class="evidence">
        <p class="evidence-meta"><strong>{{.Object}}</strong> <span class="origin-tag">{{.Origin}}</span></p>
        <pre>{{.Detail}}</pre>
      </div>
      {{- end}}
      {{- if .Link}}
      <p class="finding-link"><a href="{{.Link}}">{{.LinkLabel}} →</a></p>
      {{- end}}
    </article>
    {{- end}}
    {{- else}}
    <div class="empty"><strong>No check matched</strong>This is not a statement that the cluster is healthy: it means none of the checks below found what it looks for. What was actually examined is listed underneath.</div>
    {{- end}}
  </section>

  <section class="panel">
    <h2>What was checked</h2>
    <p class="check-summary">{{.Total}} checks —
      {{- range $i, $g := .Groups}}{{if $i}} · {{end}} <span data-state="{{$g.State}}">{{$g.Label}}</span>{{end}}</p>
    {{- range .Groups}}
    <details class="check-group"{{if .Open}} open{{end}}>
      <summary><span data-state="{{.State}}">{{.Label}}</span> <span class="gloss">— {{.Explain}}</span></summary>
      <table>
        <thead><tr><th>Check</th><th>Looks for</th><th>Note</th></tr></thead>
        <tbody>
          {{- range .Checks}}
          <tr>
            <td>{{.Name}}</td>
            <td>{{.Describes}}</td>
            <td>{{if .Because}}{{.Because}}{{else}}—{{end}}</td>
          </tr>
          {{- end}}
        </tbody>
      </table>
    </details>
    {{- end}}
    <p class="origin">source: application-derived from the snapshots the other screens render; each quoted claim names its own origin above. A check that could not run rules nothing out.</p>
  </section>
{{template "shell-close"}}
