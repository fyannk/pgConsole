{{- /*
  Diagnostics. Renders web.DiagnosticsView: the operator's own account
  of the cluster first, then findings correlated from the snapshots the
  other screens already render, then — equally load-bearing — the
  account of what was checked.

  Findings are grouped into incidents: a finding whose declared cause
  also matched — on the same pod where the relation says so, within
  its window where both carry a time — nests inside that cause's card,
  so a chain like "archiving failed → WAL filled the volume → postgres
  kept down" reads as one story with one root instead of three alarms.
  The relation is catalog-pinned knowledge and the card states its
  terms; every nested finding keeps its own quoted evidence. A cause
  that matched but on another object or at another time stays its own
  card, and the near miss is listed with the relation's reason.

  Guidance ("what to do") renders apart from the evidence and is
  labeled as the console's: advice is the one thing on this screen no
  source reported.

  The checks panel is not decoration. Findings alone would make an
  empty screen read as "nothing is wrong", which is a claim derived
  from the absence of a match rather than from anything a source
  reported. The checks are therefore all on the page, grouped by
  outcome: matches and checks that could not run stay expanded, while
  the clear majority collapses under one counted line.
*/ -}}
{{template "page-head" "diagnostics"}}
{{template "shell-open" .Shell}}
  <header>
    <div class="header-bar">
      <h1>Diagnostics</h1>
    <dl class="target">
      <dt>Cluster</dt><dd>{{.ClusterName}}</dd>
    </dl>
    </div>
    <p class="lede">Every finding restates what a source reported and quotes it. None concludes anything a source did not say.</p>
  </header>

  <section class="panel">
    <h2>Cluster state</h2>
    {{- with .State}}
    <dl class="facts state-strip">
      <dt>Operator-reported phase</dt>
      <dd><span data-state="{{.State}}">{{.Phase}}</span>{{if .PhaseReason}} — {{.PhaseReason}}{{end}}</dd>
      <dt>Instances</dt><dd>{{.Instances}}</dd>
      <dt>Current primary</dt><dd>{{.Primary}}</dd>
    </dl>
    {{- if not .Observed}}
    <p class="origin">The Cluster has not been observed yet; nothing below can be judged against its state.</p>
    {{- end}}
    {{- end}}
  </section>

  <section class="panel">
    <h2>Findings</h2>
    {{- if .Findings}}
    {{- range .Findings}}
    <article class="finding" data-severity="{{.Severity}}">
      <div class="finding-head">
        <span class="sev">{{.Severity}}</span>
        <h3>{{.Summary}}</h3>
      </div>
      {{- if .Detail}}
      <p class="finding-detail">{{.Detail}}</p>
      {{- end}}
      {{- range .Evidence}}
      <div class="evidence">
        <p class="evidence-meta"><strong>{{.Object}}</strong> <span class="origin-tag">{{.Origin}}</span></p>
        <pre>{{.Detail}}</pre>
      </div>
      {{- end}}
      {{- if .NextSteps}}
      <div class="next-steps">
        <p class="next-steps-label">What to do <span class="origin-tag">console guidance</span></p>
        <p>{{.NextSteps}}</p>
      </div>
      {{- end}}
      {{- if .Consequences}}
      <div class="finding-chain">
        <p class="chain-label">In consequence — the catalog relates these to the finding above; each keeps its own evidence:</p>
        {{- range .Consequences}}
        <details class="chained" data-severity="{{.Severity}}">
          <summary><span class="sev">{{.Severity}}</span> {{.Summary}}{{if .Via}} <span class="origin-tag">{{.Via}}</span>{{end}}</summary>
          {{- if .Detail}}
          <p class="finding-detail">{{.Detail}}</p>
          {{- end}}
          {{- range .Evidence}}
          <div class="evidence">
            <p class="evidence-meta"><strong>{{.Object}}</strong> <span class="origin-tag">{{.Origin}}</span></p>
            <pre>{{.Detail}}</pre>
          </div>
          {{- end}}
          {{- if .NextSteps}}
          <div class="next-steps">
            <p class="next-steps-label">What to do <span class="origin-tag">console guidance</span></p>
            <p>{{.NextSteps}}</p>
          </div>
          {{- end}}
          {{- if .Link}}
          <p class="finding-link"><a href="{{.Link}}">{{.LinkLabel}} →</a></p>
          {{- end}}
        </details>
        {{- end}}
      </div>
      {{- end}}
      {{- if .Related}}
      <div class="finding-related">
        <p class="chain-label">Possibly related — the catalog names these as causes of the finding above, but not on this object or at this time, so each stays its own card:</p>
        <ul>
          {{- range .Related}}
          <li>{{.Summary}}{{if .Object}} <strong>{{.Object}}</strong>{{end}} <span class="origin-tag">{{.Because}}</span></li>
          {{- end}}
        </ul>
      </div>
      {{- end}}
      {{- if .Link}}
      <p class="finding-link"><a href="{{.Link}}">{{.LinkLabel}} →</a></p>
      {{- end}}
    </article>
    {{- end}}
    {{- else}}
    <div class="empty"><strong>No check matched</strong>This is not a statement that the cluster is healthy: it means none of the checks below found what it looks for. What was actually examined is listed underneath.</div>
    {{- end}}
  </section>

  <section class="panel">
    <h2>What was checked</h2>
    <p class="check-summary">{{.Total}} checks —
      {{- range $i, $g := .Groups}}{{if $i}} · {{end}} <span data-state="{{$g.State}}">{{$g.Label}}</span>{{end}}</p>
    {{- range .Groups}}
    <details class="check-group"{{if .Open}} open{{end}}>
      <summary><span data-state="{{.State}}">{{.Label}}</span> <span class="gloss">— {{.Explain}}</span></summary>
      <table>
        <thead><tr><th>Check</th><th>Looks for</th><th>Note</th></tr></thead>
        <tbody>
          {{- range .Checks}}
          <tr>
            <td>{{.Name}}</td>
            <td>{{.Describes}}</td>
            <td>{{if .Because}}{{.Because}}{{else}}—{{end}}</td>
          </tr>
          {{- end}}
        </tbody>
      </table>
    </details>
    {{- end}}
    <p class="origin">source: application-derived from the snapshots the other screens render; each quoted claim names its own origin above. A check that could not run rules nothing out.</p>
  </section>
{{template "shell-close"}}
