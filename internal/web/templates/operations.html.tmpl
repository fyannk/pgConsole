{{- /*
  Operations index. Renders web.OperationsView: the closed catalog of
  enumerated day-2 operations. Each links to its confirmation form; no
  operation acts from this page.
*/ -}}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>pgConsole — operations {{.ClusterName}}</title>
  <link rel="stylesheet" href="/static/app.css">
</head>
<body>
  <header>
    <h1>pgConsole — operations</h1>
    <dl class="target"><dt>Cluster</dt><dd>{{.ClusterName}}</dd></dl>
    <nav class="links"><a href="/">back to the console</a></nav>
  </header>
  <main>
    <section class="panel">
      <h2>Day-2 operations</h2>
      <ul>
        {{- range .Operations}}
        <li><a href="/operations/{{.ID}}">{{.Title}}</a> — {{.Summary}}</li>
        {{- end}}
      </ul>
    </section>
  </main>
</body>
</html>
