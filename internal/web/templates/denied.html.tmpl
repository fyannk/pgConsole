{{- /*
  Denial page. Renders web.DeniedView: a constant message stating why
  the request was refused — never the identity, never probe detail.
*/ -}}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>pgConsole — denied</title>
  <link rel="icon" href="/static/favicon.svg">
  <link rel="stylesheet" href="/static/app.css">
</head>
<body>
  {{template "icons"}}
  {{template "topbar" .Shell}}
  <div class="shell">
  {{template "sidebar" .Shell}}
  <div class="content">
  <header>
    <div class="header-bar">
      <h1>pgConsole</h1>
    </div>
  </header>
  <main>
    <section class="panel">
      <h2>Access denied</h2>
      <p class="state">{{.Message}}</p>
    </section>
  </main>
  </div>
  </div>
</body>
</html>
