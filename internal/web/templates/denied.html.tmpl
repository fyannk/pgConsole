{{- /*
  Denial page. Renders web.DeniedView: a constant message stating why
  the request was refused — never the identity, never probe detail.
*/ -}}
{{template "page-head" "denied"}}
{{template "shell-open" .Shell}}
  <header>
    <div class="header-bar">
      <h1>pgConsole</h1>
    </div>
  </header>
    <section class="panel">
      <h2>Access denied</h2>
      <p class="state">{{.Message}}</p>
    </section>
{{template "shell-close"}}
