{{- /*
  The wiring diagram that opens the Overview: one inline SVG (no script,
  no external asset) drawn from a TopologyView. It reads left to right —
  apps, the write and read endpoints, the servers, and the backup
  storage — so a non-technical reader can see how their apps reach the
  database and where the data is kept. Every box carries a text label;
  colour and the primary's emphasis are reinforcement, never the only
  signal. Positions are computed server-side; the template only draws.
*/ -}}
{{- define "topology" -}}
<section class="panel topo-panel">
  <h2 class="topo-title">{{.Title}}</h2>
  <div class="topo-scroll">
  {{- /* data-topo carries the layout-free graph the enhancement layer
         re-lays this diagram out from. An attribute, not a script block:
         html/template escapes attribute values contextually, so a value
         drawn from cluster state cannot break out of it. */}}
  <svg class="topo" data-topo="{{.GraphJSON}}" viewBox="0 0 {{.Width}} {{.Height}}" role="img"
       aria-label="{{.Aria}}"
       preserveAspectRatio="xMidYMid meet">
    <defs>
      <marker id="topo-arrow" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0 L10 5 L0 10 z"></path>
      </marker>
    </defs>
    {{- range .Edges}}
    <path class="topo-edge topo-edge-{{.Kind}}" d="{{.Path}}" marker-end="url(#topo-arrow)"></path>
    {{- if .Label}}
    <text class="topo-elabel" x="{{.LabelX}}" y="{{.LabelY}}" text-anchor="middle">{{.Label}}</text>
    {{- end}}
    {{- end}}
    {{- range .Nodes}}
    <g class="topo-node topo-{{.Kind}}"{{if .State}} data-state="{{.State}}"{{end}}>
      <rect x="{{.X}}" y="{{.Y}}" width="{{.W}}" height="{{.H}}" rx="8"></rect>
      {{- if .Lines}}
      {{- range .Lines}}
      <text class="topo-{{.Class}}" x="{{.X}}" y="{{.Y}}">{{.Text}}</text>
      {{- end}}
      {{- else}}
      <text class="topo-label" x="{{add .X 14}}" y="{{add .Y 23}}">{{.Label}}</text>
      {{- if .Sub}}
      <text class="topo-sub" x="{{add .X 14}}" y="{{add .Y 40}}">{{.Sub}}</text>
      {{- end}}
      {{- if .Disk}}
      <text class="topo-disk" x="{{add .X 14}}" y="{{add .Y 54}}">{{.Disk}}</text>
      {{- end}}
      {{- end}}
    </g>
    {{- end}}
  </svg>
  </div>
  {{- if .Legend}}
  <div class="topo-legend">
    {{- range .Legend}}
    <span><svg viewBox="0 0 26 8"><path class="topo-edge topo-edge-{{.Kind}}" d="M0 4H26"></path></svg> {{.Label}}</span>
    {{- end}}
  </div>
  {{- end}}
  <p class="origin">{{.Caption}}</p>
</section>
{{- end -}}
