{{- /*
  Console page. Renders web.Page: configured target identity, the
  snapshot state with age and generation, the attributed cluster, pod,
  event, backup and ObjectStore sections, unknown panels, and configured
  link-outs as plain anchors. Claims carry the origins operator-reported,
  kubernetes-observed, or repository-evidence; the template never mixes
  them.

  Panels carry x-data="panel" and tables carry x-data="dataTable" for
  the embedded enhancement layer. Every one of those is additive: the
  document is complete before any script runs, controls that only exist
  with the script are marked x-cloak, and no state word is ever replaced
  by a colour or a mark. stateToken classifies text the server already
  rendered; it never introduces or hides a fact.
*/ -}}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>pgConsole — {{.ClusterName}}</title>
  <link rel="icon" href="/static/favicon.svg">
  <link rel="stylesheet" href="/static/app.css">
  <script src="/static/console.js" defer></script>
  <script src="/static/alpine.csp.js" defer></script>
</head>
<body>
  {{template "icons"}}
  {{template "topbar" .Shell}}
  <div class="shell">
  {{template "sidebar" .Shell}}
  <div class="content">
  <main>
    {{- with .Summary}}
    {{- /*
      The summary is the one surface that speaks across the three claim
      vocabularies — AGENTS.md rule 8 carves it out explicitly. It earns
      that by restating only what the attributed sections below already
      carry: the headline paraphrases while the sub-line quotes the
      operator verbatim beneath it, and every card still names its own
      single origin. Nothing here is a fact the page does not repeat.
    */ -}}
    <div class="verdict">
      <p class="headline" data-state="{{.HeadlineState}}">{{.Headline}}</p>
      <p class="sub">{{.Sub}}</p>
    </div>
    {{- range .Groups}}
    <h2 class="section-title">{{.Title}}</h2>
    <div class="cards">
      {{- range .Cards}}
      <div class="card">
        <span class="label">{{.Label}}</span>
        <span class="value"{{if .State}} data-state="{{.State}}"{{end}}>{{.Value}}</span>
        <span class="note">{{.Note}}</span>
        <span class="origin">source: {{.Origin.Label}}</span>
      </div>
      {{- end}}
    </div>
    {{- end}}
    <h2 class="section-title">The reported detail</h2>
    {{- end}}
    {{- with .Cluster}}
    <section class="panel sectioned" x-data="panel" data-panel="cluster">
      <div class="panel-head">
        <h2>Cluster status</h2>
        <button type="button" class="panel-toggle" x-cloak>Hide</button>
      </div>
      <div class="panel-body">
      {{- if .Absent}}
      <p class="state" data-state="degraded">absent: cluster not found in the namespace</p>
      {{- else}}
      <dl class="facts">
        <dt>Phase</dt><dd>{{.Phase}}{{if .PhaseReason}} — {{.PhaseReason}}{{end}}</dd>
        <dt>Current primary</dt><dd>{{.CurrentPrimary}}</dd>
        <dt>Target primary</dt><dd>{{.TargetPrimary}}</dd>
        <dt>Instances</dt><dd>{{.Instances}}</dd>
        <dt>Timeline</dt><dd>{{.Timeline}}</dd>
        <dt>PostgreSQL major</dt><dd>{{.PostgresVersion}}</dd>
        <dt>Image</dt><dd>{{.Image}}</dd>
      </dl>
      {{- if .Conditions}}
      <div class="table-scroll">
      <table class="conditions">
        <caption>Conditions</caption>
        <thead><tr><th>Type</th><th>Status</th><th>Reason</th><th>Message</th></tr></thead>
        <tbody>
          {{- range .Conditions}}
          <tr><td>{{.Type}}</td><td>{{.Status}}</td><td>{{.Reason}}</td><td>{{.Message}}</td></tr>
          {{- end}}
        </tbody>
      </table>
      </div>
      {{- end}}
      {{- end}}
      <p class="origin">source: {{.Origin.Label}}</p>
      </div>
    </section>
    {{- end}}
    {{- with .Pods}}
    <section class="panel sectioned" x-data="panel" data-panel="pods">
      <div class="panel-head">
        <h2>Instance pods</h2>
        <p class="meta" data-state="{{stateToken .Meta.State}}">snapshot: {{.Meta.State}} — age {{.Meta.Age}} (generation {{.Meta.Generation}})</p>
        <button type="button" class="panel-toggle" x-cloak>Hide</button>
      </div>
      <div class="panel-body">
      {{- with .Disagreement}}
      <div class="finding">
        <p class="state">disagreement on the primary instance</p>
        <p>{{.OperatorClaim}} <span class="origin">({{.OperatorOrigin.Label}})</span></p>
        <p>{{.ObservedClaim}} <span class="origin">({{.ObservedOrigin.Label}})</span></p>
      </div>
      {{- end}}
      {{- if .Rows}}
      <div x-data="dataTable">
        <div class="table-tools" x-cloak>
          <input type="search" x-model="query" placeholder="Filter pods" aria-label="Filter pods">
          <span class="count" x-text="summary"></span>
        </div>
        <div class="table-scroll">
      <table class="pods">
        <thead><tr><th>Name</th><th>Role</th><th>Phase</th><th>Ready</th><th>Restarts</th><th>Node</th><th>Image</th>{{if .LogsEnabled}}<th>Logs</th>{{end}}</tr></thead>
        <tbody>
          {{- $logsEnabled := .LogsEnabled}}
          {{- range .Rows}}
          <tr><td>{{.Name}}</td><td>{{.Role}}</td><td>{{.Phase}}</td><td>{{.Ready}}</td><td>{{.Restarts}}</td><td>{{.Node}}</td><td>{{.Image}}</td>{{if $logsEnabled}}<td>{{if .LogsURL}}<a href="{{.LogsURL}}">tail</a>{{end}}</td>{{end}}</tr>
          {{- end}}
        </tbody>
      </table>
        </div>
      </div>
      {{- else}}
      <p class="state">no member pods observed</p>
      {{- end}}
      {{- if .Truncated}}
      <p class="state">truncated: more members matched than the display bound</p>
      {{- end}}
      <p class="origin">source: {{.Origin.Label}}</p>
      </div>
    </section>
    {{- end}}
    {{- with .Events}}
    <section class="panel sectioned" x-data="panel" data-panel="events">
      <div class="panel-head">
        <h2>Events</h2>
        <p class="meta" data-state="{{stateToken .Meta.State}}">snapshot: {{.Meta.State}} — age {{.Meta.Age}} (generation {{.Meta.Generation}}) — window {{.Window}}</p>
        <button type="button" class="panel-toggle" x-cloak>Hide</button>
      </div>
      <div class="panel-body">
      {{- if .Rows}}
      <div x-data="dataTable">
        <div class="table-tools" x-cloak>
          <input type="search" x-model="query" placeholder="Filter events" aria-label="Filter events">
          <span class="count" x-text="summary"></span>
        </div>
        <div class="table-scroll">
      <table class="events">
        <thead><tr><th>Type</th><th>Reason</th><th>Object</th><th>Message</th><th>Count</th><th>Age</th></tr></thead>
        <tbody>
          {{- range .Rows}}
          <tr><td>{{.Type}}</td><td>{{.Reason}}</td><td>{{.Object}}</td><td>{{.Message}}</td><td>{{.Count}}</td><td>{{.Age}}</td></tr>
          {{- end}}
        </tbody>
      </table>
        </div>
      </div>
      {{- else}}
      <p class="state">no events in the window</p>
      {{- end}}
      {{- if .Truncated}}
      <p class="state">truncated: more events matched than the display bound</p>
      {{- end}}
      {{- if .PodEventsWithheld}}
      <p class="state">pod events withheld: membership unknown without a pod snapshot</p>
      {{- end}}
      <p class="origin">source: {{.Origin.Label}}</p>
      </div>
    </section>
    {{- end}}
    {{- with .Backups}}
    <section class="panel sectioned" x-data="panel" data-panel="backups">
      <div class="panel-head">
        <h2>Backups</h2>
        <p class="meta" data-state="{{stateToken .Meta.State}}">snapshot: {{.Meta.State}} — age {{.Meta.Age}} (generation {{.Meta.Generation}})</p>
        <button type="button" class="panel-toggle" x-cloak>Hide</button>
      </div>
      <div class="panel-body">
      <p>Last completed backup age: {{.LastCompletedAge}}</p>
      {{- with .EvidenceLink}}
      <p><a href="{{.URL}}" rel="noopener noreferrer">{{.Label}}</a></p>
      {{- end}}
      {{- if .Rows}}
      <div x-data="dataTable">
        <div class="table-tools" x-cloak>
          <input type="search" x-model="query" placeholder="Filter backups" aria-label="Filter backups">
          <span class="count" x-text="summary"></span>
        </div>
        <div class="table-scroll">
      <table class="backups">
        <caption>Backup resources</caption>
        <thead><tr><th>Name</th><th>Phase</th><th>Method</th><th>Started (UTC)</th><th>Stopped (UTC)</th><th>Age</th><th>Snapshot state</th></tr></thead>
        <tbody>
          {{- range .Rows}}
          <tr><td>{{.Name}}</td><td>{{.Phase}}</td><td>{{.Method}}</td><td>{{.Started}}</td><td>{{.Stopped}}</td><td>{{.Age}}</td><td>{{.SnapshotState}}</td></tr>
          {{- end}}
        </tbody>
      </table>
        </div>
      </div>
      {{- else}}
      <p class="state">no Backup resources observed for this cluster</p>
      {{- end}}
      {{- if .BackupsTruncated}}
      <p class="state">truncated: the Backup catalog reached its safety or display bound</p>
      {{- end}}
      {{- if .ScheduledRows}}
      <div class="table-scroll">
      <table class="scheduled-backups">
        <caption>ScheduledBackup resources</caption>
        <thead><tr><th>Name</th><th>Method</th><th>Schedule</th><th>Suspended</th><th>Last schedule (UTC)</th><th>Next schedule (UTC)</th></tr></thead>
        <tbody>
          {{- range .ScheduledRows}}
          <tr><td>{{.Name}}</td><td>{{.Method}}</td><td>{{.Schedule}}</td><td>{{.Suspended}}</td><td>{{.LastSchedule}}</td><td>{{.NextSchedule}}</td></tr>
          {{- end}}
        </tbody>
      </table>
      </div>
      {{- else}}
      <p class="state">no ScheduledBackup resources observed for this cluster</p>
      {{- end}}
      {{- if .SchedulesTruncated}}
      <p class="state">truncated: the ScheduledBackup catalog reached its safety or display bound</p>
      {{- end}}
      <p class="origin">source: {{.Origin.Label}}</p>
      </div>
    </section>
    {{- end}}
    {{- with .ObjectStore}}
    <section class="panel sectioned" x-data="panel" data-panel="objectstore">
      <div class="panel-head">
        <h2>ObjectStore reference</h2>
        <button type="button" class="panel-toggle" x-cloak>Hide</button>
      </div>
      <div class="panel-body">
      <dl class="facts">
        <dt>Name</dt><dd>{{.Name}}</dd>
        <dt>Cluster reference</dt><dd>{{.ReferenceState}} <span class="origin">({{.ReferenceOrigin.Label}})</span></dd>
        <dt>API lookup</dt><dd>{{.ObservationState}} <span class="origin">({{.ObservationOrigin.Label}})</span></dd>
      </dl>
      </div>
    </section>
    {{- end}}
    {{- with .Repository}}
    <section class="panel sectioned" x-data="panel" data-panel="repository">
      <div class="panel-head">
        <h2>Repository evidence</h2>
        <p class="meta" data-state="{{stateToken .Meta.State}}">sidecar contact: {{.Meta.State}} — age {{.Meta.Age}} (generation {{.Meta.Generation}}){{if .ContactFailure}} — {{.ContactFailure}}{{end}}</p>
        <button type="button" class="panel-toggle" x-cloak>Hide</button>
      </div>
      <div class="panel-body">
      {{- if .SourceStale}}
      <p class="state" data-state="stale">stale: the sidecar reports its evidence no longer reflects the latest refresh attempt</p>
      {{- end}}
      <dl class="facts">
        <dt>Repository</dt><dd>{{.Repository}}</dd>
        <dt>Scope</dt><dd>{{.Scope}}</dd>
        <dt>Destination fingerprint</dt><dd>{{.Fingerprint}}</dd>
        <dt>Cluster identity</dt><dd>{{.ClusterIdentity}}</dd>
        <dt>Producer version</dt><dd>{{.ProducerVersion}}</dd>
        <dt>Overall</dt><dd>{{.Overall.Display}}</dd>
        <dt>Completeness</dt><dd>{{.Completeness}}</dd>
        <dt>Evidence generation</dt><dd>{{.EvidenceGeneration}} (revision {{.Revision}})</dd>
        <dt>Scan completed (UTC)</dt><dd>{{.ScanCompleted}}</dd>
        <dt>Last attempt (UTC)</dt><dd>{{.LastAttempt}}</dd>
        <dt>Inventory</dt><dd>{{.Inventory}}{{if .InventoryFailure}} — last attempt failed: {{.InventoryFailure}}{{end}}</dd>
      </dl>
      {{- if .DetailsUnknown}}
      <p class="state">format details unknown: unrecognized variant {{.DetailsType}}</p>
      {{- end}}
      {{- with .Barman}}
      <dl class="facts">
        <dt>Backups (structural)</dt><dd>{{.Backups}}{{if .BackupStates}} — {{.BackupStates}}{{end}}</dd>
        <dt>WAL continuity</dt><dd>{{.WAL.Display}}{{if .WALCounts}} — {{.WALCounts}}{{end}}</dd>
        <dt>Timeline history</dt><dd>{{.Timeline.Display}}</dd>
        <dt>Recovery coverage</dt><dd>{{.Coverage.Display}}</dd>
        <dt>Retention</dt><dd>{{.Retention.Display}} — {{.RetentionBackups}} — {{.RetentionMinimum}}</dd>
        <dt>Completion window (UTC)</dt><dd>{{.RetentionWindow}}</dd>
        <dt>Latest archive receipt age</dt><dd>{{.LatestArchiveAge}}</dd>
      </dl>
      {{- if .Truncated}}
      <p class="state">truncated: the sidecar reached a safety ceiling; affected conclusions are unknown</p>
      {{- end}}
      {{- end}}
      {{- if .Capabilities}}
      <div class="table-scroll">
      <table class="capabilities">
        <caption>Evidence capabilities</caption>
        <thead><tr><th>Capability</th><th>Support</th><th>State</th></tr></thead>
        <tbody>
          {{- range .Capabilities}}
          <tr><td>{{.ID}}</td><td>{{.Support}}</td><td>{{.State}}</td></tr>
          {{- end}}
        </tbody>
      </table>
      </div>
      {{- end}}
      <p class="origin">source: {{.Origin.Label}}</p>
      </div>
    </section>
    {{- end}}
    {{- with .CrossCheck}}
    <section class="panel sectioned" x-data="panel" data-panel="crosscheck">
      <div class="panel-head">
        <h2>Backup cross-check</h2>
        <button type="button" class="panel-toggle" x-cloak>Hide</button>
      </div>
      <div class="panel-body">
      {{- if .Degraded}}
      <p class="state" data-state="degraded">correlation unknown: {{.Degraded}}</p>
      {{- end}}
      {{- if .FindingCount}}
      <div class="finding">
        <p class="state">{{.FindingCount}} cross-check finding(s) below</p>
      </div>
      {{- end}}
      {{- if .Rows}}
      <div x-data="dataTable">
        <div class="table-tools" x-cloak>
          <input type="search" x-model="query" placeholder="Filter cross-check" aria-label="Filter cross-check">
          <span class="count" x-text="summary"></span>
        </div>
        <div class="table-scroll">
      <table class="cross-check">
        <caption>Backup resources beside repository evidence</caption>
        <thead><tr><th>Backup</th><th>Operator claim</th><th>Backup ID</th><th>Repository evidence</th><th>Outcome</th></tr></thead>
        <tbody>
          {{- $operator := .OperatorOrigin}}{{- $repository := .RepositoryOrigin}}
          {{- range .Rows}}
          <tr{{if .Finding}} class="finding"{{end}}><td>{{.Name}}</td><td>{{.OperatorClaim}} <span class="origin">({{$operator.Label}})</span></td><td>{{.BackupID}}</td><td>{{.RepositoryClaim}} <span class="origin">({{$repository.Label}})</span></td><td>{{.Outcome}} — {{.Detail}}</td></tr>
          {{- end}}
        </tbody>
      </table>
        </div>
      </div>
      {{- else}}
      <p class="state">no Backup resources to cross-check</p>
      {{- end}}
      {{- if .OrphansUnknown}}
      <p class="state">repository orphans unknown: {{.OrphansUnknown}}</p>
      {{- else if .Orphans}}
      <div class="table-scroll">
      <table class="orphans">
        <caption>Repository backups no resource accounts for</caption>
        <thead><tr><th>Backup ID</th><th>Repository evidence</th><th>Completed (UTC)</th></tr></thead>
        <tbody>
          {{- range .Orphans}}
          <tr class="finding"><td>{{.BackupID}}</td><td>{{.RepositoryClaim}}</td><td>{{.Completed}}</td></tr>
          {{- end}}
        </tbody>
      </table>
      </div>
      {{- if .OrphansTruncated}}
      <p class="state">truncated: more orphaned repository backups than the display bound</p>
      {{- end}}
      {{- else}}
      <p class="state">no repository backups outside the operator's catalog</p>
      {{- end}}
      <p class="origin">sources: {{.OperatorOrigin.Label}} and {{.RepositoryOrigin.Label}}, correlated by exact backup ID</p>
      </div>
    </section>
    {{- end}}
    {{- range .Panels}}
    <section class="panel sectioned">
      <div class="panel-head">
        <h2>{{.Title}}</h2>
        <p class="meta" data-state="{{stateToken .State}}">{{.State}}</p>
      </div>
      <div class="panel-body">
      <p class="state">{{.State}}: {{.Detail}}</p>
      <p class="origin">source: {{.Origin.Label}}</p>
      </div>
    </section>
    {{- end}}
  </main>
  </div>
  </div>
</body>
</html>
