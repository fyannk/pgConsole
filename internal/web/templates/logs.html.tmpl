{{- /*
  Log tail page. Renders web.LogsView: one bounded, on-demand tail of a
  verified member pod's PostgreSQL container, kubernetes-observed. The
  content renders as escaped text only; it is never cached or persisted.
*/ -}}
{{template "page-head" "log tail"}}
{{template "shell-open" .Shell}}
  <header>
    <div class="header-bar">
      <h1>pgConsole — log tail</h1>
    <dl class="target">
      <dt>Cluster</dt><dd>{{.ClusterName}}</dd>
      <dt>Pod</dt><dd>{{.Pod}}</dd>
    </dl>
    </div>
  </header>
    <section class="panel">
      <h2>PostgreSQL container logs</h2>
      {{- if .State}}
      <p class="state">{{.State}}</p>
      {{- else}}
      <p class="meta">{{.Bounds}} — fetched on demand, never stored</p>
      {{- if .Truncated}}
      <p class="state">truncated: the byte ceiling cut this tail</p>
      {{- end}}
      <pre class="logs">{{.Content}}</pre>
      {{- end}}
      <p class="origin">source: {{.Origin.Label}}</p>
    </section>
{{template "shell-close"}}
