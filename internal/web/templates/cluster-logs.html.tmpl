{{- /*
  Cluster logs. The launch points for the bounded, on-demand log tail —
  one row per observed member pod. The tail itself is the poweruser-gated
  /logs route; membership is re-verified live at fetch time and nothing
  is stored. Below the poweruser level the launch links are absent, and
  the screen says why rather than offering a link that would deny.
*/ -}}
{{template "page-head" "logs"}}
{{template "shell-open" .Shell}}
    <section class="panel">
      <h2>Instance logs</h2>
      <p class="meta">A log tail is a bounded, on-demand fetch for one member pod: at most a set number of lines and bytes, fetched on the request and never stored.</p>
      {{- with .Pods}}
      {{- if .Rows}}
      {{- if .LogsEnabled}}
      <div class="table-scroll">
      <table class="pod-logs">
        <thead><tr><th>Pod</th><th>Role</th><th>Phase</th><th>Log tail</th></tr></thead>
        <tbody>
          {{- range .Rows}}
          <tr><td>{{.Name}}</td><td>{{.Role}}</td><td>{{.Phase}}</td><td>{{if .LogsURL}}<a href="{{.LogsURL}}">tail</a>{{else}}—{{end}}</td></tr>
          {{- end}}
        </tbody>
      </table>
      </div>
      {{- else}}
      <div class="empty"><strong>Logs need the poweruser level</strong>The bounded log tail sits above the read-only baseline. Have the trusted proxy assert the poweruser level or above to reach it.</div>
      {{- end}}
      {{- else}}
      <p class="state">no member pods observed to tail</p>
      {{- end}}
      {{- else}}
      <div class="empty"><strong>No pods snapshot yet</strong>There are no observed instance pods to tail logs from.</div>
      {{- end}}
      <p class="origin">source: kubernetes-observed</p>
    </section>
{{template "shell-close"}}
