{{- /*
  Access-request review panel. Renders web.AccessReviewView: the dba-only
  list of pgToolBox access requests. Pending requests carry approve and
  deny forms, each POSTing a CSRF token bound to the action and request;
  decided requests are a read-only audit list. This console records the
  reviewer's decision on the request status only — the operator's
  controller materializes the user after an approval.
*/ -}}
{{template "page-head" "access requests"}}
{{template "shell-open" .Shell}}
  <header>
    <div class="header-bar">
      <h1>pgConsole — access requests</h1>
    <dl class="target"><dt>Cluster</dt><dd>{{.ClusterName}}</dd></dl>
    </div>
  </header>
    <section class="panel">
      <h2>Pending requests</h2>
      <p class="origin">source: Kubernetes ({{.Meta.State}}, observed {{.Meta.Age}} ago, generation {{.Meta.Generation}})</p>
      {{- if not .HasSnapshot}}
      <p class="state">unknown: no observation yet</p>
      {{- else if .Truncated}}
      <p class="state">the request list reached its safety or display bound; older requests are not shown</p>
      {{- end}}
      {{- if .Pending}}
      <table>
        <thead><tr><th>Subject</th><th>Message</th><th>Age</th><th>Decision</th></tr></thead>
        <tbody>
          {{- range .Pending}}
          <tr>
            <td>{{.Subject}}</td>
            <td>{{.Message}}</td>
            <td>{{.Age}}</td>
            <td>
              <form method="POST" action="/access-requests/{{.Name}}/approve" hx-boost="false">
                <input type="hidden" name="csrf" value="{{.ApproveToken}}">
                <label>Level
                  <select name="level" required>
                    <option value="" disabled selected>choose a level</option>
                    {{- range $.Levels}}
                    <option value="{{.}}">{{.}}</option>
                    {{- end}}
                  </select>
                </label>
                <button type="submit">Approve</button>
              </form>
              <form method="POST" action="/access-requests/{{.Name}}/deny" hx-boost="false">
                <input type="hidden" name="csrf" value="{{.DenyToken}}">
                <button type="submit" class="danger">Deny</button>
              </form>
            </td>
          </tr>
          {{- end}}
        </tbody>
      </table>
      {{- else if .HasSnapshot}}
      <p class="state">no pending requests</p>
      {{- end}}
    </section>

    <section class="panel">
      <h2>Decided requests</h2>
      {{- if .Decided}}
      <table>
        <thead><tr><th>Subject</th><th>State</th><th>Level</th><th>Decided by</th><th>Age</th></tr></thead>
        <tbody>
          {{- range .Decided}}
          <tr><td>{{.Subject}}</td><td>{{.State}}</td><td>{{if .RequestedLevel}}{{.RequestedLevel}}{{else}}—{{end}}</td><td>{{.DecidedBy}}</td><td>{{.DecidedAge}}</td></tr>
          {{- end}}
        </tbody>
      </table>
      {{- else}}
      <p class="state">no decided requests</p>
      {{- end}}
    </section>
{{template "shell-close"}}
