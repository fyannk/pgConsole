{{- /*
  Shared chrome: the icon sprite, the fixed top bar, and the section
  map in the sidebar. Every page composes these three, so the console
  presents one shell regardless of which handler rendered the page.

  The map is a set of real destinations, each a page this build serves.
  A capability that is switched off in this deployment (operations,
  access review) is shown as a non-link marked aria-disabled rather than
  omitted, so the shape of the console stays legible and a reader can
  tell "off here" from "not a thing". The current page is marked
  aria-current from ShellView.Current.

  Icons are an inline SVG sprite, not image requests: the
  Content-Security-Policy sets img-src 'self', and inline markup is not
  a fetch at all. Every sidebar entry carries a text label beside its
  icon; the icon is never the only signal, and the label is what
  survives when the sidebar is collapsed to its rail (the entry keeps
  its title attribute).
*/ -}}

{{- define "icons" -}}
<svg class="icon-sprite" width="0" height="0" aria-hidden="true" focusable="false"><defs>
<symbol id="i-overview" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="5" height="5" rx="1"></rect><rect x="9" y="2" width="5" height="5" rx="1"></rect><rect x="2" y="9" width="5" height="5" rx="1"></rect><rect x="9" y="9" width="5" height="5" rx="1"></rect></symbol>
<symbol id="i-external" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 3H3.5A.5.5 0 0 0 3 3.5v9a.5.5 0 0 0 .5.5h9a.5.5 0 0 0 .5-.5V9"></path><path d="M9.5 2.5H13.5V6.5"></path><path d="M13.5 2.5 8 8"></path></symbol>
<symbol id="i-cluster" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="3.5" r="2"></circle><circle cx="3.5" cy="12" r="2"></circle><circle cx="12.5" cy="12" r="2"></circle><path d="M8 5.5 4.4 10.3M8 5.5l3.6 4.8"></path></symbol>
<symbol id="i-status" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="8" r="5.5"></circle><path d="M5.75 8.25 7.25 9.75 10.5 6.5"></path></symbol>
<symbol id="i-pods" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2.5" width="12" height="3.5" rx="1"></rect><rect x="2" y="10" width="12" height="3.5" rx="1"></rect><path d="M4.5 4.25h.01M4.5 11.75h.01"></path></symbol>
<symbol id="i-events" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="8" r="5.5"></circle><path d="M8 5v3.5"></path><path d="M8 10.75h.01"></path></symbol>
<symbol id="i-backups" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="8" cy="4" rx="5" ry="2"></ellipse><path d="M3 4v8c0 1.1 2.24 2 5 2s5-.9 5-2V4"></path><path d="M3 8c0 1.1 2.24 2 5 2s5-.9 5-2"></path></symbol>
<symbol id="i-objects" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2.5" width="12" height="4" rx="1"></rect><rect x="2" y="9.5" width="12" height="4" rx="1"></rect></symbol>
<symbol id="i-evidence" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="7" cy="7" r="4.5"></circle><path d="M10.5 10.5 14 14"></path></symbol>
<symbol id="i-databases" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="8" cy="3.5" rx="5" ry="1.8"></ellipse><path d="M3 3.5v9c0 1 2.24 1.8 5 1.8s5-.8 5-1.8v-9"></path><path d="M3 8c0 1 2.24 1.8 5 1.8s5-.8 5-1.8"></path></symbol>
<symbol id="i-roles" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="6.5" r="2.5"></circle><path d="M10 6.5h4M12.5 6.5v2M14 6.5v1.5"></path><path d="M2 13.5v-.5A2.5 2.5 0 0 1 4.5 10.5h3A2.5 2.5 0 0 1 10 13v.5"></path></symbol>
<symbol id="i-replication" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 5.5h9l-2-2M13.5 10.5h-9l2 2"></path></symbol>
<symbol id="i-poolers" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="4" cy="8" r="2.25"></circle><circle cx="12" cy="8" r="2.25"></circle><path d="M6.25 8h3.5"></path></symbol>
<symbol id="i-logs" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 4h11M2.5 7h11M2.5 10h7.5M2.5 13h5"></path></symbol>
<symbol id="i-operations" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="8" r="2"></circle><path d="M8 1.5v2M8 12.5v2M1.5 8h2M12.5 8h2M3.4 3.4l1.4 1.4M11.2 11.2l1.4 1.4M12.6 3.4l-1.4 1.4M4.8 11.2l-1.4 1.4"></path></symbol>
<symbol id="i-access" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M11 13.5v-1a2.5 2.5 0 0 0-2.5-2.5h-3A2.5 2.5 0 0 0 3 12.5v1"></path><circle cx="7" cy="5" r="2.5"></circle></symbol>
</defs></svg>
{{- end -}}

{{- /* topbar renders a ShellView. Cluster identity and the refresh
       control stay reachable while a table scrolls; the snapshot line
       and forwarded identity join them only when the page carries them. */ -}}
{{- define "topbar" -}}
<header class="topbar">
  <h1>pgConsole</h1>
  <dl class="target">
    {{- if .Namespace}}
    <dt>Namespace</dt><dd>{{.Namespace}}</dd>
    {{- end}}
    <dt>Cluster</dt><dd>{{.ClusterName}}</dd>
    {{- if .SnapshotState}}
    <dt>Snapshot</dt><dd data-state="{{stateToken .SnapshotState}}">{{.SnapshotState}}{{if .SnapshotAge}} — age {{.SnapshotAge}} (generation {{.Generation}}){{end}}</dd>
    {{- end}}
    {{- with .Identity}}
    <dt>Identity</dt><dd>{{.User}} — {{.Level}} ({{.Label}})</dd>
    {{- end}}
  </dl>
  <div class="refresh" x-data="autoRefresh" x-cloak>
    <label><input type="checkbox" x-model="on"> Auto-refresh</label>
    <span class="countdown" x-text="status"></span>
  </div>
</header>
{{- end -}}

{{- /* sidebar renders a ShellView. Current keys: overview,
       cluster-status, cluster-pods, cluster-events, cluster-logs,
       backups-overview, backups-objects, backups-evidence,
       databases-overview, databases-roles, databases-publications,
       databases-subscriptions,
       poolers-overview, poolers-pods, poolers-logs, operations, access. */ -}}
{{- define "sidebar" -}}
<aside class="sidebar" x-data="sidebar" data-collapsed="false" aria-label="Console sections">
  <div class="sidebar-top">
    <span class="sidebar-heading">Sections</span>
    <button type="button" class="sidebar-toggle" x-cloak aria-label="Collapse navigation"></button>
  </div>
  <nav class="sidebar-nav">
    <a class="sidebar-link" href="/"{{if eq .Current "overview"}} aria-current="page"{{end}} title="Overview"><svg><use href="#i-overview"></use></svg><span class="sidebar-label">Overview</span></a>

    {{- range .Links}}
    <a class="sidebar-link" href="{{.URL}}" target="_blank" rel="noopener noreferrer" title="{{.Label}} (new tab)"><svg><use href="#i-external"></use></svg><span class="sidebar-label">{{.Label}}</span></a>
    {{- end}}

    <div class="sidebar-group">
      <a class="sidebar-link sidebar-group-label" href="/cluster/status" title="Cluster"><svg><use href="#i-cluster"></use></svg><span>Cluster</span></a>
      <div class="sidebar-sub">
        <a class="sidebar-link" href="/cluster/status"{{if eq .Current "cluster-status"}} aria-current="page"{{end}} title="Status"><svg><use href="#i-status"></use></svg><span class="sidebar-label">Status</span></a>
        <a class="sidebar-link" href="/cluster/pods"{{if eq .Current "cluster-pods"}} aria-current="page"{{end}} title="Pods"><svg><use href="#i-pods"></use></svg><span class="sidebar-label">Pods</span></a>
        <a class="sidebar-link" href="/cluster/events"{{if eq .Current "cluster-events"}} aria-current="page"{{end}} title="Events"><svg><use href="#i-events"></use></svg><span class="sidebar-label">Events</span></a>
        <a class="sidebar-link" href="/cluster/logs"{{if eq .Current "cluster-logs"}} aria-current="page"{{end}} title="Logs"><svg><use href="#i-logs"></use></svg><span class="sidebar-label">Logs</span></a>
      </div>
    </div>

    <div class="sidebar-group">
      <a class="sidebar-link sidebar-group-label" href="/backups" title="Backups"><svg><use href="#i-backups"></use></svg><span>Backups</span></a>
      <div class="sidebar-sub">
        <a class="sidebar-link" href="/backups"{{if eq .Current "backups-overview"}} aria-current="page"{{end}} title="Overview"><svg><use href="#i-status"></use></svg><span class="sidebar-label">Overview</span></a>
        <a class="sidebar-link" href="/backups/objects"{{if eq .Current "backups-objects"}} aria-current="page"{{end}} title="Objects"><svg><use href="#i-objects"></use></svg><span class="sidebar-label">Objects</span></a>
        <a class="sidebar-link" href="/backups/evidence"{{if eq .Current "backups-evidence"}} aria-current="page"{{end}} title="Evidence"><svg><use href="#i-evidence"></use></svg><span class="sidebar-label">Evidence</span></a>
      </div>
    </div>

    <div class="sidebar-group">
      <a class="sidebar-link sidebar-group-label" href="/databases" title="Databases"><svg><use href="#i-databases"></use></svg><span>Databases</span></a>
      <div class="sidebar-sub">
        <a class="sidebar-link" href="/databases"{{if eq .Current "databases-overview"}} aria-current="page"{{end}} title="Databases"><svg><use href="#i-databases"></use></svg><span class="sidebar-label">Databases</span></a>
        <a class="sidebar-link" href="/databases/roles"{{if eq .Current "databases-roles"}} aria-current="page"{{end}} title="Roles"><svg><use href="#i-roles"></use></svg><span class="sidebar-label">Roles</span></a>
        <a class="sidebar-link" href="/databases/publications"{{if eq .Current "databases-publications"}} aria-current="page"{{end}} title="Publications"><svg><use href="#i-replication"></use></svg><span class="sidebar-label">Publications</span></a>
        <a class="sidebar-link" href="/databases/subscriptions"{{if eq .Current "databases-subscriptions"}} aria-current="page"{{end}} title="Subscriptions"><svg><use href="#i-replication"></use></svg><span class="sidebar-label">Subscriptions</span></a>
      </div>
    </div>

    <div class="sidebar-group">
      <a class="sidebar-link sidebar-group-label" href="/poolers" title="Poolers"><svg><use href="#i-poolers"></use></svg><span>Poolers</span></a>
      <div class="sidebar-sub">
        <a class="sidebar-link" href="/poolers"{{if eq .Current "poolers-overview"}} aria-current="page"{{end}} title="Overview"><svg><use href="#i-status"></use></svg><span class="sidebar-label">Overview</span></a>
        <a class="sidebar-link" href="/poolers/pods"{{if eq .Current "poolers-pods"}} aria-current="page"{{end}} title="Pods"><svg><use href="#i-pods"></use></svg><span class="sidebar-label">Pods</span></a>
        <a class="sidebar-link" href="/poolers/logs"{{if eq .Current "poolers-logs"}} aria-current="page"{{end}} title="Logs"><svg><use href="#i-logs"></use></svg><span class="sidebar-label">Logs</span></a>
      </div>
    </div>

    {{- if .OperationsEnabled}}
    <a class="sidebar-link" href="/operations"{{if eq .Current "operations"}} aria-current="page"{{end}} title="Day-2 operations"><svg><use href="#i-operations"></use></svg><span class="sidebar-label">Operations</span></a>
    {{- else}}
    <span class="sidebar-link" aria-disabled="true" title="Operations — disabled in this deployment"><svg><use href="#i-operations"></use></svg><span class="sidebar-label">Operations</span></span>
    {{- end}}

    {{- if .AccessReviewEnabled}}
    <a class="sidebar-link" href="/access-requests"{{if eq .Current "access"}} aria-current="page"{{end}} title="Access requests"><svg><use href="#i-access"></use></svg><span class="sidebar-label">Access requests</span></a>
    {{- else}}
    <span class="sidebar-link" aria-disabled="true" title="Access requests — disabled in this deployment"><svg><use href="#i-access"></use></svg><span class="sidebar-label">Access requests</span></span>
    {{- end}}
  </nav>
</aside>
{{- end -}}

{{- /* page-head opens the document. The argument is the page title
       suffix; the stylesheet and the embedded enhancement layer are the
       only assets, both served from this binary. */ -}}
{{- define "page-head" -}}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>pgConsole — {{.}}</title>
  <link rel="icon" href="/static/favicon.svg">
  <link rel="stylesheet" href="/static/app.css">
  <script src="/static/console.js" defer></script>
  <script src="/static/alpine.csp.js" defer></script>
</head>
<body>
{{- end -}}

{{- /* shell-open takes a ShellView and lays out the icon sprite, the
       fixed top bar, the sidebar, and the content column up to <main>.
       shell-close balances it. */ -}}
{{- define "shell-open" -}}
{{template "icons"}}
{{template "topbar" .}}
<div class="shell">
{{template "sidebar" .}}
<div class="content">
<main>
{{- end -}}

{{- define "shell-close" -}}
</main>
</div>
</div>
</body>
</html>
{{- end -}}
