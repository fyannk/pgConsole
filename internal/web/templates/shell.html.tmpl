{{- /*
  Shared chrome: the icon sprite, the fixed top bar, and the section
  map in the sidebar. Every page composes these three, so the console
  presents one shell regardless of which handler rendered the page.

  The map is deliberately complete. A destination this build does not
  serve renders as a non-link marked aria-disabled rather than being
  omitted, so the shape of the console is legible from any page and a
  reader can tell the difference between "not here" and "not yet".

  Icons are an inline SVG sprite, not image requests: the
  Content-Security-Policy sets img-src 'self', and inline markup is not
  a fetch at all. Every sidebar entry carries a text label beside its
  icon; the icon is never the only signal, and the label is what
  survives when the sidebar is collapsed to its rail (the entry keeps
  its title attribute).
*/ -}}

{{- define "icons" -}}
<svg class="icon-sprite" width="0" height="0" aria-hidden="true" focusable="false"><defs>
<symbol id="i-overview" viewBox="0 0 16 16"><rect x="2" y="2" width="5" height="5" rx="1"></rect><rect x="9" y="2" width="5" height="5" rx="1"></rect><rect x="2" y="9" width="5" height="5" rx="1"></rect><rect x="9" y="9" width="5" height="5" rx="1"></rect></symbol>
<symbol id="i-cluster" viewBox="0 0 16 16"><circle cx="8" cy="3.5" r="2"></circle><circle cx="3.5" cy="12" r="2"></circle><circle cx="12.5" cy="12" r="2"></circle><path d="M8 5.5 4.4 10.3M8 5.5l3.6 4.8"></path></symbol>
<symbol id="i-status" viewBox="0 0 16 16"><circle cx="8" cy="8" r="5.5"></circle><path d="M5.75 8.25 7.25 9.75 10.5 6.5"></path></symbol>
<symbol id="i-pods" viewBox="0 0 16 16"><rect x="2" y="2.5" width="12" height="3.5" rx="1"></rect><rect x="2" y="10" width="12" height="3.5" rx="1"></rect><path d="M4.5 4.25h.01M4.5 11.75h.01"></path></symbol>
<symbol id="i-events" viewBox="0 0 16 16"><circle cx="8" cy="8" r="5.5"></circle><path d="M8 5v3.5"></path><path d="M8 10.75h.01"></path></symbol>
<symbol id="i-logs" viewBox="0 0 16 16"><path d="M2.5 4h11M2.5 7h11M2.5 10h7.5M2.5 13h5"></path></symbol>
<symbol id="i-backups" viewBox="0 0 16 16"><ellipse cx="8" cy="4" rx="5" ry="2"></ellipse><path d="M3 4v8c0 1.1 2.24 2 5 2s5-.9 5-2V4"></path><path d="M3 8c0 1.1 2.24 2 5 2s5-.9 5-2"></path></symbol>
<symbol id="i-objects" viewBox="0 0 16 16"><rect x="2" y="2.5" width="12" height="4" rx="1"></rect><rect x="2" y="9.5" width="12" height="4" rx="1"></rect></symbol>
<symbol id="i-evidence" viewBox="0 0 16 16"><circle cx="7" cy="7" r="4.5"></circle><path d="M10.5 10.5 14 14"></path></symbol>
<symbol id="i-poolers" viewBox="0 0 16 16"><circle cx="4" cy="8" r="2.25"></circle><circle cx="12" cy="8" r="2.25"></circle><path d="M6.25 8h3.5"></path></symbol>
<symbol id="i-operations" viewBox="0 0 16 16"><circle cx="8" cy="8" r="2"></circle><path d="M8 1.5v2M8 12.5v2M1.5 8h2M12.5 8h2M3.4 3.4l1.4 1.4M11.2 11.2l1.4 1.4M12.6 3.4l-1.4 1.4M4.8 11.2l-1.4 1.4"></path></symbol>
<symbol id="i-access" viewBox="0 0 16 16"><path d="M11 13.5v-1a2.5 2.5 0 0 0-2.5-2.5h-3A2.5 2.5 0 0 0 3 12.5v1"></path><circle cx="7" cy="5" r="2.5"></circle></symbol>
<symbol id="i-external" viewBox="0 0 16 16"><path d="M7 3H3.5A.5.5 0 0 0 3 3.5v9a.5.5 0 0 0 .5.5h9a.5.5 0 0 0 .5-.5V9"></path><path d="M9.5 2.5H13.5V6.5"></path><path d="M13.5 2.5 8 8"></path></symbol>
</defs></svg>
{{- end -}}

{{- /* topbar renders a ShellView. */ -}}
{{- define "topbar" -}}
<header class="topbar">
  <h1>pgConsole</h1>
  <dl class="target">
    <dt>Cluster</dt><dd>{{.ClusterName}}</dd>
    {{- if .Namespace}}
    <dt>Namespace</dt><dd>{{.Namespace}}</dd>
    {{- end}}
    {{- if .SnapshotState}}
    <dt>Snapshot</dt><dd data-state="{{stateToken .SnapshotState}}">{{.SnapshotState}}{{if .SnapshotAge}} — age {{.SnapshotAge}} (generation {{.Generation}}){{end}}</dd>
    {{- end}}
    {{- with .Identity}}
    <dt>Identity</dt><dd>{{.User}} — {{.Level}} ({{.Label}})</dd>
    {{- end}}
  </dl>
  <div class="refresh" x-data="autoRefresh" x-cloak>
    <label><input type="checkbox" x-model="on"> Auto-refresh</label>
    <span class="countdown" x-text="status"></span>
  </div>
</header>
{{- end -}}

{{- /* navlink renders one entry. Expects a dict-free struct via the
       nav helper below; kept inline instead to avoid a template func. */ -}}

{{- /* sidebar renders a ShellView. */ -}}
{{- define "sidebar" -}}
<aside class="sidebar" x-data="sidebar" data-collapsed="false" aria-label="Console sections">
  <div class="sidebar-top">
    <span class="sidebar-heading">Sections</span>
    <button type="button" class="sidebar-toggle" x-cloak aria-label="Collapse navigation"></button>
  </div>
  <nav class="sidebar-nav">
    <a class="sidebar-link" href="/"{{if eq .Current "overview"}} aria-current="page"{{end}} title="Overview"><svg><use href="#i-overview"></use></svg><span class="sidebar-label">Overview</span></a>

    <div class="sidebar-group">
      <span class="sidebar-link sidebar-group-label" aria-disabled="true" title="Cluster"><svg><use href="#i-cluster"></use></svg><span>Cluster</span></span>
      <div class="sidebar-sub">
        <span class="sidebar-link" aria-disabled="true" title="Status — not served by this build"><svg><use href="#i-status"></use></svg><span class="sidebar-label">Status</span></span>
        <span class="sidebar-link" aria-disabled="true" title="Pods — not served by this build"><svg><use href="#i-pods"></use></svg><span class="sidebar-label">Pods</span></span>
        <span class="sidebar-link" aria-disabled="true" title="Events — not served by this build"><svg><use href="#i-events"></use></svg><span class="sidebar-label">Events</span></span>
        <span class="sidebar-link" aria-disabled="true" title="Logs — reached from a pod row"><svg><use href="#i-logs"></use></svg><span class="sidebar-label">Logs</span></span>
      </div>
    </div>

    <div class="sidebar-group">
      <span class="sidebar-link sidebar-group-label" aria-disabled="true" title="Backups"><svg><use href="#i-backups"></use></svg><span>Backups</span></span>
      <div class="sidebar-sub">
        <span class="sidebar-link" aria-disabled="true" title="Overview — not served by this build"><svg><use href="#i-status"></use></svg><span class="sidebar-label">Overview</span></span>
        <span class="sidebar-link" aria-disabled="true" title="Objects — not served by this build"><svg><use href="#i-objects"></use></svg><span class="sidebar-label">Objects</span></span>
        <span class="sidebar-link" aria-disabled="true" title="Evidence — not served by this build"><svg><use href="#i-evidence"></use></svg><span class="sidebar-label">Evidence</span></span>
      </div>
    </div>

    <div class="sidebar-group">
      <span class="sidebar-link sidebar-group-label" aria-disabled="true" title="Poolers — no Pooler observer in this build"><svg><use href="#i-poolers"></use></svg><span>Poolers</span></span>
      <div class="sidebar-sub">
        <span class="sidebar-link" aria-disabled="true" title="Overview — no Pooler observer in this build"><svg><use href="#i-status"></use></svg><span class="sidebar-label">Overview</span></span>
        <span class="sidebar-link" aria-disabled="true" title="Pods — no Pooler observer in this build"><svg><use href="#i-pods"></use></svg><span class="sidebar-label">Pods</span></span>
        <span class="sidebar-link" aria-disabled="true" title="Logs — no Pooler observer in this build"><svg><use href="#i-logs"></use></svg><span class="sidebar-label">Logs</span></span>
      </div>
    </div>

    {{- if .OperationsEnabled}}
    <a class="sidebar-link" href="/operations"{{if eq .Current "operations"}} aria-current="page"{{end}} title="Day-2 operations"><svg><use href="#i-operations"></use></svg><span class="sidebar-label">Operations</span></a>
    {{- else}}
    <span class="sidebar-link" aria-disabled="true" title="Operations — disabled in this deployment"><svg><use href="#i-operations"></use></svg><span class="sidebar-label">Operations</span></span>
    {{- end}}

    {{- if .AccessReviewEnabled}}
    <a class="sidebar-link" href="/access-requests"{{if eq .Current "access"}} aria-current="page"{{end}} title="Access requests"><svg><use href="#i-access"></use></svg><span class="sidebar-label">Access requests</span></a>
    {{- else}}
    <span class="sidebar-link" aria-disabled="true" title="Access requests — disabled in this deployment"><svg><use href="#i-access"></use></svg><span class="sidebar-label">Access requests</span></span>
    {{- end}}

    {{- range .Links}}
    <a class="sidebar-link" href="{{.URL}}" target="_blank" rel="noopener noreferrer" title="{{.Label}} (new tab)"><svg><use href="#i-external"></use></svg><span class="sidebar-label">{{.Label}}</span></a>
    {{- end}}
  </nav>
</aside>
{{- end -}}
