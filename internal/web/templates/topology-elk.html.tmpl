{{- /*
  The same wiring diagram a third time: ELK decides the geometry in the
  browser, and the console's own script draws it as the same SVG the
  server emits — same classes, same rounded orthogonal runs — so it
  inherits the stylesheet and the theme rather than carrying a second
  appearance of its own.

  An enhancement like the Cytoscape panel: the section ships hidden and
  is unhidden only once ELK has answered, so a reader without scripting
  sees the finished drawing above and no empty frame. The graph travels
  in an attribute, not a script block, so html/template's contextual
  escaping stays in charge.
*/ -}}
{{- define "topology-elk" -}}
{{- $graph := .GraphJSON}}
{{- if $graph}}
<section class="panel topo-panel" data-topo-elk data-topo-graph="{{$graph}}" data-topo-aria="{{.Aria}}" hidden>
  <h2 class="topo-title">{{.Title}} — ELK layout</h2>
  <div class="topo-scroll" data-topo-elk-canvas></div>
  {{- if .Legend}}
  <div class="topo-legend">
    {{- range .Legend}}
    <span><svg viewBox="0 0 26 8"><path class="topo-edge topo-edge-{{.Kind}}" d="M0 4H26"></path></svg> {{.Label}}</span>
    {{- end}}
  </div>
  {{- end}}
  <p class="origin">The same graph again, with ELK deciding the geometry and the console drawing it as the SVG above; it states no fact the drawing does not.</p>
</section>
{{- end}}
{{- end -}}
