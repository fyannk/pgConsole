{{- /*
  Backups — objects. The operator-reported Backup and ScheduledBackup
  catalogs, and the Kubernetes-observed ObjectStore reference lookup.
  A completed phase stays an attributed operator claim; the metadata
  lookup that resolves the plugin ObjectStore keeps its own origin.
*/ -}}
{{template "page-head" "backup objects"}}
{{template "shell-open" .Shell}}
    {{- with .Backups}}
    <section class="panel sectioned">
      <div class="panel-head">
        <h2>Backup catalog</h2>
        <p class="meta" data-state="{{stateToken .Meta.State}}">snapshot: {{.Meta.State}} — age {{.Meta.Age}} (generation {{.Meta.Generation}})</p>
      </div>
      <div class="panel-body">
      <p>Last completed backup age: {{.LastCompletedAge}}</p>
      {{- if .Rows}}
      <div x-data="dataTable">
        <div class="table-tools" x-cloak>
          <input type="search" x-model="query" placeholder="Filter backups" aria-label="Filter backups">
          <span class="count" x-text="summary"></span>
        </div>
        <div class="table-scroll">
      <table class="backups">
        <caption>Backup resources</caption>
        <thead><tr><th>Name</th><th>Phase</th><th>Method</th><th>Started (UTC)</th><th>Stopped (UTC)</th><th>Age</th><th>Snapshot state</th></tr></thead>
        <tbody>
          {{- range .Rows}}
          <tr><td>{{.Name}}</td><td>{{.Phase}}</td><td>{{.Method}}</td><td>{{template "stamp" .Started}}</td><td>{{template "stamp" .Stopped}}</td><td>{{.Age}}</td><td>{{.SnapshotState}}</td></tr>
          {{- end}}
        </tbody>
      </table>
        </div>
      </div>
      {{- else}}
      <p class="state">no Backup resources observed for this cluster</p>
      {{- end}}
      {{- if .BackupsTruncated}}
      <p class="state">truncated: the Backup catalog reached its safety or display bound</p>
      {{- end}}
      {{- if .ScheduledRows}}
      <div class="table-scroll">
      <table class="scheduled-backups">
        <caption>ScheduledBackup resources</caption>
        <thead><tr><th>Name</th><th>Method</th><th>Schedule</th><th>Suspended</th><th>Last schedule (UTC)</th><th>Next schedule (UTC)</th></tr></thead>
        <tbody>
          {{- range .ScheduledRows}}
          <tr><td>{{.Name}}</td><td>{{.Method}}</td><td>{{.Schedule}}</td><td>{{.Suspended}}</td><td>{{template "stamp" .LastSchedule}}</td><td>{{template "stamp" .NextSchedule}}</td></tr>
          {{- end}}
        </tbody>
      </table>
      </div>
      {{- else}}
      <p class="state">no ScheduledBackup resources observed for this cluster</p>
      {{- end}}
      {{- if .SchedulesTruncated}}
      <p class="state">truncated: the ScheduledBackup catalog reached its safety or display bound</p>
      {{- end}}
      <p class="origin">source: {{.Origin.Label}}</p>
      </div>
    </section>
    {{- else}}
    <section class="panel">
      <h2>Backup catalog</h2>
      <div class="empty"><strong>No backup snapshot yet</strong>The operator's Backup and ScheduledBackup resources have not been observed for this cluster.</div>
      <p class="origin">source: operator-reported</p>
    </section>
    {{- end}}
    {{- with .ObjectStore}}
    <section class="panel sectioned">
      <div class="panel-head">
        <h2>ObjectStore reference</h2>
      </div>
      <div class="panel-body">
      <dl class="facts">
        <dt>Name</dt><dd>{{.Name}}</dd>
        <dt>Cluster reference</dt><dd>{{.ReferenceState}} <span class="origin">({{.ReferenceOrigin.Label}})</span></dd>
        <dt>API lookup</dt><dd>{{.ObservationState}} <span class="origin">({{.ObservationOrigin.Label}})</span></dd>
      </dl>
      </div>
    </section>
    {{- end}}
{{template "shell-close"}}
